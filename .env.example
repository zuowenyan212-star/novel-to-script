# v0.3 Qiniu model config
# Quick start can also read this .env without installing python-dotenv.
# Copy this file to .env, then replace LLM_API_KEY.

LLM_PROVIDER=qiniu
LLM_API_KEY=your_qiniu_api_key_here
LLM_BASE_URL=https://api.qnaigc.com/v1
LLM_MODEL=deepseek-v3

# If your network needs system proxy to access Qiniu/GitHub, set true.
# If false, quick-start model requests avoid system proxy variables.
LLM_USE_SYSTEM_PROXY=false

# Backward-compatible OpenAI-style names. You can leave them empty if LLM_* is configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.qnaigc.com/v1
OPENAI_MODEL=deepseek-v3

USE_MOCK_LLM=false

APP_HOST=127.0.0.1
APP_PORT=8000
MAX_INPUT_CHARS=30000
