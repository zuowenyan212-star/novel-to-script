# Enhanced model config
# The frontend supports two providers:
# 1. local: local rule-based demo model, no API key required
# 2. qiniu: Qiniu OpenAI-compatible API

LLM_PROVIDER=qiniu
LLM_API_KEY=your_qiniu_api_key_here
LLM_BASE_URL=https://api.qnaigc.com/v1
LLM_MODEL=deepseek-v3
LLM_USE_SYSTEM_PROXY=false

# Backward-compatible OpenAI-style names. You can leave them empty if LLM_* is configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.qnaigc.com/v1
OPENAI_MODEL=deepseek-v3

# If true, old backend calls can still use mock mode.
# The recommended demo path is selecting "本地演示模型" on the page.
USE_MOCK_LLM=false

# App config
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_INPUT_CHARS=30000
