# OpenAI-compatible model config
# If USE_MOCK_LLM=true, the project can run without an API key for demo/testing.
USE_MOCK_LLM=true

# To use a real model, set USE_MOCK_LLM=false and fill these values.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# App config
APP_HOST=127.0.0.1
APP_PORT=8000
